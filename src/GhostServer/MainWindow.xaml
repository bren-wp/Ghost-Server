                    <Grid x:Name="FilesPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource IconButton}" Click="RemoteUp_Click" ToolTip="Up one folder">
                                    <TextBlock Text="&#xE74A;" Style="{StaticResource FluentIcon}"/>
                                </Button>
                                <TextBox x:Name="RemotePathBox" Grid.Column="1" Style="{StaticResource GhostTextBox}"
                                         Margin="8,0" Text="/" KeyDown="RemotePathBox_KeyDown"/>
                                <Button Grid.Column="2" Style="{StaticResource AccentButton}" Click="RefreshFiles_Click" ToolTip="Open path / refresh">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/><TextBlock Text="Open" Margin="7,0,0,0" Foreground="#06121E"/></StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,2">
                            <Button Style="{StaticResource GhostButton}" Click="UploadFile_Click" Margin="0,0,8,8" ToolTip="Upload a local file to this folder">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Upload" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="DownloadFile_Click" Margin="0,0,8,8" ToolTip="Download the selected remote file">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Download" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                            <TextBlock x:Name="FilesStatusText" Foreground="{StaticResource GhostMuted}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" MaxWidth="420"/>
                        </WrapPanel>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8">
                            <ListView x:Name="RemoteFilesList" Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource GhostIce}" MouseDoubleClick="RemoteFiles_DoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="360"/>
                                        <GridViewColumn Header="Type" DisplayMemberBinding="{Binding TypeLabel}" Width="110"/>
                                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SizeLabel}" Width="130"/>
                                        <GridViewColumn Header="Modified" DisplayMemberBinding="{Binding LastWriteTime}" Width="190"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>

                    <Grid x:Name="ServicesPage" Visibility="Collapsed" Margin="24">
