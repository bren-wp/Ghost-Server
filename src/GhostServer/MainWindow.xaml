<Window x:Class="GhostServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Ghost Server"
        Width="1180" Height="760"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource GhostNavy}"
        Foreground="{StaticResource GhostIce}"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="51"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#08182B" BorderBrush="{StaticResource GhostBorder}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource GhostBlue}">
                        <TextBlock Text="&#xE968;" Style="{StaticResource FluentIcon}" Foreground="#06121E"
                                   FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ghost Server" FontWeight="SemiBold" FontSize="15" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border Background="{StaticResource GhostPanel}" BorderBrush="{StaticResource GhostBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="10,0,0,0">
                        <TextBlock x:Name="AppVersionBadge" Text="…" Foreground="{StaticResource GhostMuted}" FontSize="10"/>
                    </Border>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center"
                        Margin="0" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <TextBlock Text="&#xE921;" Style="{StaticResource FluentIcon}" FontSize="12"/>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center"
                        Margin="0" Click="Maximize_Click" ToolTip="Fit window to screen" AutomationProperties.Name="Fit window to screen">
                    <TextBlock Text="&#xE922;" Style="{StaticResource FluentIcon}" FontSize="12"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource NavButton}" HorizontalContentAlignment="Center"
                        Margin="0" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource FluentIcon}" FontSize="12"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="198"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0A1A2E" BorderBrush="{StaticResource GhostBorder}" BorderThickness="0,0,1,0">
                <Grid x:Name="SidebarInnerGrid" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SidebarTitle" Grid.Row="0" Text="NAVIGATION" Foreground="{StaticResource GhostMuted}" FontSize="10"
                               FontWeight="SemiBold" Margin="12,8,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,10">
                        <StackPanel x:Name="SidebarNavigationPanel">
                            <TextBlock x:Name="SidebarOverviewHeading" Text="OVERVIEW" Foreground="{StaticResource GhostMuted}" FontSize="9.5"
                                       FontWeight="SemiBold" Margin="8,2,0,6"/>
                            <Button x:Name="DashboardNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Dashboard" Click="DashboardNav_Click" ToolTip="Dashboard">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE80F;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Dashboard" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="FleetNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Fleet" Click="FleetNav_Click" ToolTip="Fleet, alerts and trends">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE716;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Fleet" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="SidebarManageHeading" Text="MANAGE" Foreground="{StaticResource GhostMuted}" FontSize="9.5"
                                       FontWeight="SemiBold" Margin="8,10,0,6"/>
                            <Button x:Name="FilesNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Files" Click="FilesNav_Click" ToolTip="SFTP files">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8B7;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Files" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="ServicesNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Services" Click="ServicesNav_Click" ToolTip="Services">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Services" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="DockerNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Docker" Click="DockerNav_Click" ToolTip="Docker">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7B8;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Docker" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="NetworkNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Network" Click="NetworkNav_Click" ToolTip="Network and firewall">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE774;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Network" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="SidebarOperationsHeading" Text="OPERATIONS" Foreground="{StaticResource GhostMuted}" FontSize="9.5"
                                       FontWeight="SemiBold" Margin="8,10,0,6"/>
                            <Button x:Name="UpdatesNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Safe Update" Click="UpdatesNav_Click" ToolTip="Safe Update, backup and scheduled tasks">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE895;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Safe Update" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="SystemNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="System" Click="SystemNav_Click" ToolTip="System, databases and logs">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE950;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="System" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="TerminalNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Terminal" Click="TerminalNav_Click" ToolTip="Terminal">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE756;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Terminal" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>
                            <Button x:Name="SecurityNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Security" Click="SecurityNav_Click" ToolTip="Security">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xEA18;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Security" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>

                            <TextBlock x:Name="SidebarAppHeading" Text="APP" Foreground="{StaticResource GhostMuted}" FontSize="9.5"
                                       FontWeight="SemiBold" Margin="8,10,0,6"/>
                            <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" AutomationProperties.Name="Settings" Click="SettingsNav_Click" ToolTip="Settings and about">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE713;" Style="{StaticResource SidebarNavIcon}"/>
                                    <TextBlock Grid.Column="1" Text="Settings" Style="{StaticResource SidebarNavLabel}"/>
                                </Grid>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="SidebarFooter" Grid.Row="2" Background="{StaticResource GhostPanel}" BorderBrush="{StaticResource GhostBorder}"
                            BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="SSH-first" FontWeight="SemiBold"/>
                            <TextBlock Text="Passwords stay in memory only. Host keys are pinned after explicit approval."
                                       Foreground="{StaticResource GhostMuted}" FontSize="11" TextWrapping="Wrap"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{StaticResource GhostNavy}">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ContentHeaderRow" Height="84"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource GhostBorder}" BorderThickness="0,0,0,1">
                    <Grid x:Name="ContentHeaderGrid" Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSubtitle" Text="Server health, services and connection state."
                                       Foreground="{StaticResource GhostMuted}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AccentButton}"
                                VerticalAlignment="Center" Click="OpenAddServer_Click" ToolTip="Add server (Ctrl+N)"
                                AutomationProperties.Name="Add server">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/>
                                <TextBlock x:Name="HeaderAddServerText" Text="Add server" Margin="7,0,0,0" Foreground="#06121E" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid x:Name="DashboardPage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DashboardServerColumn" Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#0A1A2E" BorderBrush="{StaticResource GhostBorder}"
                                BorderThickness="0,0,1,0">
                            <Grid Margin="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="SERVERS" Foreground="{StaticResource GhostMuted}" FontWeight="SemiBold"
                                           FontSize="11" Margin="8,6,0,10"/>
                                <ListBox x:Name="ServerList" Grid.Row="1" ItemsSource="{Binding Profiles}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource GhostIce}"
                                         ItemContainerStyle="{StaticResource ServerListItemStyle}"
                                         SelectionChanged="ServerList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="ServerCard" Background="{StaticResource GhostPanel}" BorderBrush="{StaticResource GhostBorder}"
                                                    BorderThickness="1" CornerRadius="10" Padding="12" Width="258">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Endpoint}" Foreground="{StaticResource GhostMuted}"
                                                                   FontSize="11" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Ellipse Grid.Column="1" Width="8" Height="8" Fill="{StaticResource GhostMuted}"
                                                             VerticalAlignment="Center" ToolTip="Saved server profile"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter TargetName="ServerCard" Property="Background" Value="{StaticResource GhostSelectedSurface}"/>
                                                    <Setter TargetName="ServerCard" Property="BorderBrush" Value="{StaticResource GhostBlue}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="24">
                            <Border x:Name="EmptyState" Style="{StaticResource CardBorder}" MaxWidth="620"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Margin="20" HorizontalAlignment="Center">
                                    <TextBlock Text="No server selected" FontSize="22" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add an SSH server, approve its host key, then Ghost Server can read live health and service data."
                                               TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource GhostMuted}"
                                               Margin="0,10,0,18" MaxWidth="440"/>
                                    <Button Content="Add first server" Style="{StaticResource AccentButton}"
                                            HorizontalAlignment="Center" Click="OpenAddServer_Click"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer x:Name="ServerDetail" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,6">
                                        <StackPanel Width="300" Margin="0,0,14,8">
                                            <TextBlock x:Name="SelectedName" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="SelectedEndpoint" Foreground="{StaticResource GhostMuted}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,10,0,0">
                                                <Button Style="{StaticResource GhostButton}" Padding="10,6" Click="OpenEditServer_Click" Margin="0,0,7,7" ToolTip="Edit selected server">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource FluentIcon}" FontSize="13"/><TextBlock Text="Edit" Margin="6,0,0,0"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource GhostButton}" Padding="10,6" Click="ResetHostKey_Click" Margin="0,0,7,7" ToolTip="Forget pinned SSH host key">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource FluentIcon}" FontSize="13"/><TextBlock Text="Reset trust" Margin="6,0,0,0"/></StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource DangerButton}" Padding="10,6" Click="DeleteServer_Click" Margin="0,0,0,7" ToolTip="Delete selected server">
                                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" FontSize="13" Foreground="{StaticResource GhostDanger}"/><TextBlock Text="Delete" Margin="6,0,0,0"/></StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel Width="260" Margin="0,0,0,8">
                                            <Label Content="Session password / key passphrase"/>
                                            <PasswordBox x:Name="SessionSecretBox" Style="{StaticResource GhostPasswordBox}"/>
                                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="10,5"
                                                    Margin="0,7,0,0" Click="LockSession_Click" ToolTip="Clear the in-memory session secret (Ctrl+L)">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource FluentIcon}" FontSize="12"/><TextBlock Text="Lock session" Margin="6,0,0,0"/></StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </WrapPanel>

                                    <WrapPanel Margin="0,0,0,16">
                                        <Button Style="{StaticResource AccentButton}" Click="Connect_Click" Margin="0,0,8,8" ToolTip="Connect and refresh dashboard (F5)">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/><TextBlock Text="Connect &amp; refresh" Margin="7,0,0,0" Foreground="#06121E"/></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Click="RefreshServices_Click" Margin="0,0,8,8" ToolTip="Refresh dashboard service list">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" FontSize="13"/><TextBlock Text="Refresh services" Margin="7,0,0,0"/></StackPanel>
                                        </Button>
                                        <CheckBox x:Name="AutoRefreshToggle" Content="Auto refresh • 30s"
                                                  Foreground="{StaticResource GhostMuted}" VerticalAlignment="Center"
                                                  Margin="6,0,10,8" Checked="AutoRefresh_Changed" Unchecked="AutoRefresh_Changed"
                                                  ToolTip="Refresh server health and running services every 30 seconds"/>
                                        <TextBlock x:Name="ConnectionStatus" Text="Not connected"
                                                   Foreground="{StaticResource GhostMuted}" VerticalAlignment="Center"
                                                   Margin="6,0,0,8"
                                                   AutomationProperties.Name="Connection status"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </WrapPanel>

                                    <Border x:Name="HostKeyPanel" Visibility="Collapsed" Style="{StaticResource CardBorder}"
                                            Margin="0,0,0,16" BorderBrush="{StaticResource GhostWarning}">
                                        <StackPanel>
                                            <TextBlock Text="Host key approval required" Foreground="{StaticResource GhostWarning}"
                                                       FontWeight="SemiBold" FontSize="16"/>
                                            <TextBlock Text="Verify this SHA-256 fingerprint with your server provider or administrator before trusting it."
                                                       TextWrapping="Wrap" Foreground="{StaticResource GhostMuted}" Margin="0,6,0,8"/>
                                            <TextBlock x:Name="HostKeyFingerprint" FontFamily="Cascadia Code, Consolas"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock x:Name="HostKeyAlgorithm" Foreground="{StaticResource GhostMuted}" Margin="0,5,0,10"/>
                                            <WrapPanel>
                                                <Button Content="Trust fingerprint" Style="{StaticResource AccentButton}"
                                                        Click="TrustHostKey_Click" Margin="0,0,8,8"/>
                                                <Button Content="Reject" Style="{StaticResource GhostButton}" Click="RejectHostKey_Click" Margin="0,0,0,8"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <WrapPanel Margin="0,0,0,16">
                                        <Border Style="{StaticResource CardBorder}" Width="180" Height="106" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="CPU" Foreground="{StaticResource GhostMuted}" FontSize="11"/>
                                                <TextBlock x:Name="CpuValue" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorder}" Width="180" Height="106" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="MEMORY" Foreground="{StaticResource GhostMuted}" FontSize="11"/>
                                                <TextBlock x:Name="MemoryValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorder}" Width="180" Height="106" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="DISK /" Foreground="{StaticResource GhostMuted}" FontSize="11"/>
                                                <TextBlock x:Name="DiskValue" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource CardBorder}" Width="180" Height="106" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="LOAD" Foreground="{StaticResource GhostMuted}" FontSize="11"/>
                                                <TextBlock x:Name="LoadValue" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="SYSTEM" Foreground="{StaticResource GhostMuted}" FontSize="11"/>
                                                <TextBlock Text="Hostname" Margin="0,12,0,0"/>
                                                <TextBlock Text="OS" Margin="0,7,0,0"/>
                                                <TextBlock Text="Kernel" Margin="0,7,0,0"/>
                                                <TextBlock Text="Uptime" Margin="0,7,0,0"/>
                                                <TextBlock Text="Docker" Margin="0,7,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text=" " FontSize="11"/>
                                                <TextBlock x:Name="HostnameValue" Text="—" Margin="0,12,0,0"/>
                                                <TextBlock x:Name="OsValue" Text="—" Margin="0,7,0,0"/>
                                                <TextBlock x:Name="KernelValue" Text="—" Margin="0,7,0,0"/>
                                                <TextBlock x:Name="UptimeValue" Text="—" Margin="0,7,0,0"/>
                                                <TextBlock x:Name="DockerValue" Text="—" Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource CardBorder}">
                                        <StackPanel>
                                            <TextBlock Text="RUNNING SERVICES" Foreground="{StaticResource GhostMuted}"
                                                       FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                            <ListView x:Name="ServicesList" Background="Transparent" BorderThickness="0"
                                                      Foreground="{StaticResource GhostIce}" MaxHeight="280">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Service" DisplayMemberBinding="{Binding Name}" Width="190"/>
                                                        <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="120"/>
                                                        <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="360"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Grid x:Name="FleetPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,4">
                            <TextBox x:Name="FleetFilterBox" Style="{StaticResource GhostTextBox}"
                                     Width="250" Margin="0,0,8,8"
                                     ToolTip="Filter fleet by name, endpoint, user, health or operating system"
                                     TextChanged="FleetFilterBox_TextChanged"/>
                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                                    Click="RefreshFleetInventory_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Refresh inventory" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                                    Click="ProbeFleetKeyProfiles_Click" ToolTip="Read-only health probe for trusted private-key profiles that do not require a passphrase">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/><TextBlock Text="Probe key profiles" Margin="7,0,0,0" Foreground="#06121E"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubNavButton}" Margin="0,0,6,8"
                                    Click="AlertsNav_Click" ToolTip="Open Fleet alerts">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA8F;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Alerts" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubNavButton}" Margin="0,0,0,8"
                                    Click="TrendsNav_Click" ToolTip="Open Fleet trends">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Trends" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                        </WrapPanel>

                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
