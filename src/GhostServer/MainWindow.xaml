                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Text="Current user crontab is shown here for visibility only. Ghost Server does not edit it."/>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="SystemPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,10">
                            <Button Style="{StaticResource AccentButton}" Click="RefreshSystem_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/>
                                    <TextBlock Text="Refresh system" Margin="7,0,0,0" Foreground="#06121E"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Click="TerminateProcess_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource GhostDanger}"/>
                                    <TextBlock Text="Terminate selected" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubNavButton}" Click="DatabasesNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D4;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Databases" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubNavButton}" Click="LogsNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF000;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Logs" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                            <TextBlock x:Name="SystemStatusText" Foreground="{StaticResource GhostMuted}" VerticalAlignment="Center"
                                       Margin="0,0,0,8" Text="Processes, filesystems and signed-in users are loaded read-only."/>
                        </WrapPanel>

                        <TextBlock Grid.Row="1" Foreground="{StaticResource GhostMuted}" Margin="2,0,0,10"
                                   Text="Terminate sends SIGTERM only. Ghost Server never sends SIGKILL automatically."/>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8">
                            <ListView x:Name="ProcessesList" Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource GhostIce}" SelectionChanged="ProcessesList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="PID" DisplayMemberBinding="{Binding Pid}" Width="75"/>
                                        <GridViewColumn Header="User" DisplayMemberBinding="{Binding User}" Width="115"/>
                                        <GridViewColumn Header="CPU %" DisplayMemberBinding="{Binding CpuPercent}" Width="80"/>
                                        <GridViewColumn Header="RAM %" DisplayMemberBinding="{Binding MemoryPercent}" Width="80"/>
                                        <GridViewColumn Header="Elapsed" DisplayMemberBinding="{Binding Elapsed}" Width="110"/>
                                        <GridViewColumn Header="Command" DisplayMemberBinding="{Binding Command}" Width="310"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="0">
                            <TextBox x:Name="SystemOverviewOutput" IsReadOnly="True" AcceptsReturn="True"
                                     Background="#071522" Foreground="{StaticResource GhostIce}" BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas" Padding="14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Text="Select a server to inspect memory, filesystems, block devices, logged-in users and load."/>
                        </Border>
                    </Grid>

                    <Grid x:Name="DatabasesPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,10">
                            <Button Style="{StaticResource AccentButton}" Click="RefreshDatabases_Click" Margin="0,0,10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/>
                                    <TextBlock Text="Refresh databases" Margin="7,0,0,0" Foreground="#06121E"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Read-only discovery only. Ghost Server does not execute SQL mutations or store database passwords."
                                       Foreground="{StaticResource GhostMuted}" VerticalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                        </WrapPanel>

                        <TextBlock Grid.Row="1" x:Name="DatabasesStatusText"
                                   Foreground="{StaticResource GhostMuted}" Margin="2,0,0,10"
                                   Text="Select a server, then refresh database engines."/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardBorder}" Padding="8">
                                <ListView x:Name="DatabaseEnginesList"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="{StaticResource GhostIce}"
                                          SelectionChanged="DatabaseEnginesList_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Engine" DisplayMemberBinding="{Binding Engine}" Width="105"/>
                                            <GridViewColumn Header="Version" DisplayMemberBinding="{Binding Version}" Width="260"/>
                                            <GridViewColumn Header="Service" DisplayMemberBinding="{Binding ServiceStatus}" Width="100"/>
                                            <GridViewColumn Header="Access" DisplayMemberBinding="{Binding Access}" Width="180"/>
                                            <GridViewColumn Header="DBs" DisplayMemberBinding="{Binding DatabaseCount}" Width="60"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Database names"
                                               FontWeight="SemiBold"
                                               Margin="14,12,14,8"/>
                                    <TextBox Grid.Row="1"
                                             x:Name="DatabaseNamesOutput"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             Background="#071522"
                                             Foreground="{StaticResource GhostIce}"
                                             BorderThickness="0"
                                             FontFamily="Cascadia Code, Consolas"
                                             Padding="14"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             Text="Select a database engine to inspect discovered database names."/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="280"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource AccentButton}" Click="RefreshLogs_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/><TextBlock Text="Refresh logs" Margin="7,0,0,0" Foreground="#06121E"/></StackPanel>
                            </Button>
                            <TextBlock Grid.Column="1" Text="Latest 200 entries. Service and Docker log shortcuts also open here."
                                       Foreground="{StaticResource GhostMuted}" VerticalAlignment="Center" Margin="12,0,12,0"/>
                            <TextBox Grid.Column="2" x:Name="LogsFilterBox" Style="{StaticResource GhostTextBox}"
                                     ToolTip="Filter visible log lines" TextChanged="LogsFilter_TextChanged"/>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                            <TextBox x:Name="LogsOutput" IsReadOnly="True" AcceptsReturn="True"
                                     Background="#071522" Foreground="{StaticResource GhostIce}" BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas" Padding="14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="TerminalPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Interactive shell" FontWeight="SemiBold"/>
                                        <TextBlock Text="•" Foreground="{StaticResource GhostMuted}" Margin="8,0"/>
                                        <TextBlock x:Name="TerminalSessionStatus" Text="Disconnected"
                                                   Foreground="{StaticResource GhostMuted}"/>
                                    </StackPanel>
                                    <Button x:Name="ConnectTerminalButton" Grid.Column="1"
                                            Style="{StaticResource AccentButton}" Margin="8,0,0,0"
                                            Click="ConnectTerminal_Click" ToolTip="Connect a persistent SSH shell session">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE703;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/>
                                            <TextBlock Text="Connect shell" Margin="7,0,0,0" Foreground="#06121E"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DisconnectTerminalButton" Grid.Column="2"
                                            Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Click="DisconnectTerminal_Click" IsEnabled="False"
                                            ToolTip="Disconnect the current interactive SSH shell">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE711;" Style="{StaticResource FluentIcon}"/>
                                            <TextBlock Text="Disconnect" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Persistent line-oriented SSH shell. Working directory and shell state are preserved until you disconnect, switch servers, lock the session or close Ghost Server."
                                           Foreground="{StaticResource GhostMuted}" FontSize="11" Margin="2,8,0,0"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Command" Foreground="{StaticResource GhostMuted}" FontSize="11"
                                           Margin="0,14,0,0"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CommandInput" Style="{StaticResource GhostTextBox}"
                                             FontFamily="Cascadia Code, Consolas" KeyDown="CommandInput_KeyDown"
                                             ToolTip="Enter command. Use Up/Down for command history."/>
                                    <Button x:Name="SendTerminalButton" Grid.Column="1"
                                            Style="{StaticResource AccentButton}"
                                            Margin="8,0,0,0" Click="RunCommand_Click" IsEnabled="False"
                                            ToolTip="Send command to the connected shell">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE768;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/>
                                            <TextBlock Text="Send" Margin="7,0,0,0" Foreground="#06121E"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="ClearTerminal_Click"
                                            ToolTip="Clear terminal output locally">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}"/>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="QuickCommandBox" Style="{StaticResource GhostComboBox}" SelectedIndex="0"
                                              ToolTip="Read-only command presets. Insert first, then review and send manually.">
                                        <ComboBoxItem Content="System summary" Tag="uptime; printf '\nMemory\n'; free -h; printf '\nRoot filesystem\n'; df -h /"/>
                                        <ComboBoxItem Content="Top processes" Tag="ps -eo pid,user,pcpu,pmem,etime,comm --sort=-pcpu | head -n 20"/>
                                        <ComboBoxItem Content="Listening sockets" Tag="ss -lntup 2>/dev/null || netstat -lntup 2>/dev/null"/>
                                        <ComboBoxItem Content="Disk usage" Tag="df -hPT"/>
                                        <ComboBoxItem Content="Docker containers" Tag="docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}'"/>
                                        <ComboBoxItem Content="Recent errors" Tag="journalctl -p err -n 80 --no-pager"/>
                                    </ComboBox>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                            Click="InsertQuickCommand_Click" ToolTip="Insert preset into the command editor without sending it">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B5;" Style="{StaticResource FluentIcon}"/>
                                            <TextBlock Text="Insert preset" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Quick Commands are read-only presets. Ghost Server never sends a preset until you press Send."
                                           Foreground="{StaticResource GhostMuted}" FontSize="11" Margin="2,7,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" x:Name="TerminalServerLabel"
                                   Foreground="{StaticResource GhostMuted}" Margin="2,0,0,8"/>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                            <TextBox x:Name="TerminalOutput" IsReadOnly="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="#071522" Foreground="{StaticResource GhostIce}" BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas" Padding="14" AcceptsReturn="True"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="NetworkPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,4">
                            <Button Style="{StaticResource AccentButton}" Click="RefreshNetwork_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/><TextBlock Text="Refresh network" Margin="7,0,0,0" Foreground="#06121E"/></StackPanel>
                            </Button>
                            <TextBlock Text="Network discovery is read-only. Firewall changes require an explicit action and elevated remote privileges."
                                       Foreground="{StaticResource GhostMuted}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="650" Margin="0,0,0,8"/>
                        </WrapPanel>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <WrapPanel>
                                <StackPanel Width="320" Margin="0,0,10,8">
                                    <TextBlock Text="Allow firewall port" FontWeight="SemiBold"/>
                                    <TextBlock Text="Supports UFW and firewalld. Ghost Server never creates deny rules or disables the firewall."
                                               Foreground="{StaticResource GhostMuted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <TextBox x:Name="FirewallPortBox" Width="110" Style="{StaticResource GhostTextBox}"
                                         Margin="0,0,8,8" ToolTip="Port 1-65535"/>
                                <ComboBox x:Name="FirewallProtocolBox" Width="110" Style="{StaticResource GhostComboBox}"
                                          SelectedIndex="0" Margin="0,0,8,8">
                                    <ComboBoxItem Content="TCP" Tag="tcp"/>
                                    <ComboBoxItem Content="UDP" Tag="udp"/>
                                </ComboBox>
                                <Button Style="{StaticResource GhostButton}" Click="AllowFirewallPort_Click" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FB;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Allow port" Margin="7,0,0,0"/></StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                            <TextBox x:Name="NetworkOutput" IsReadOnly="True" AcceptsReturn="True"
                                     Background="#071522" Foreground="{StaticResource GhostIce}" BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas" Padding="14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>

                    <Grid x:Name="UpdatesPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Style="{StaticResource GhostButton}" Click="RefreshUpdates_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Preview updates" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource AccentButton}" Click="RunSafeUpdate_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE895;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/><TextBlock Text="Run Safe Update" Margin="7,0,0,0" Foreground="#06121E"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="RestoreConfigSnapshot_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Restore config snapshot" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubNavButton}" Click="BackupNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C7;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Backup" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubNavButton}" Click="TasksNav_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE823;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Tasks" Margin="6,0,0,0"/></StackPanel>
                            </Button>
                        </WrapPanel>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12" BorderBrush="{StaticResource GhostWarning}">
                            <StackPanel>
                                <TextBlock Text="Safe Update guardrails" Foreground="{StaticResource GhostWarning}" FontWeight="SemiBold"/>
                                <TextBlock Text="Ghost Server requires a downloaded configuration snapshot before package changes, at least 1 GiB of free root-disk space and passwordless sudo. It never reboots automatically. Restore config snapshot restores only allowlisted configuration paths; it does not claim to downgrade updated packages."
                                           Foreground="{StaticResource GhostMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0">
                            <TextBox x:Name="UpdatesOutput" IsReadOnly="True" AcceptsReturn="True"
                                     Background="#071522" Foreground="{StaticResource GhostIce}" BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas" Padding="14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Text="Preview pending updates first. Safe Update will require a local configuration snapshot before making package changes."/>
                        </Border>
                    </Grid>

                    <Grid x:Name="BackupPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Configuration snapshot" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Creates a temporary .tar.gz containing detected SSH, web server, systemd, Docker, Fail2ban and firewall configuration, downloads it over SFTP, then removes the temporary remote archive."
                                               Foreground="{StaticResource GhostMuted}" TextWrapping="Wrap" Margin="0,7,18,0" MaxWidth="720"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Click="CreateConfigBackup_Click" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C7;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/><TextBlock Text="Create &amp; download" Margin="7,0,0,0" Foreground="#06121E"/></StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                            <TextBox x:Name="BackupOutput" IsReadOnly="True" AcceptsReturn="True"
                                     Background="#071522" Foreground="{StaticResource GhostIce}" BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas" Padding="14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Text="Ready. Select a server, unlock the session, then create a configuration snapshot."/>
                        </Border>
                    </Grid>

                    <Grid x:Name="SecurityPage" Visibility="Collapsed" Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,4">
                            <Button Content="Run read-only security scan" Style="{StaticResource AccentButton}"
                                    Click="SecurityScan_Click" Margin="0,0,8,8"/>
                            <TextBlock Text="No changes are made to the server." Foreground="{StaticResource GhostMuted}"
                                       VerticalAlignment="Center" Margin="0,0,0,8"/>
                        </WrapPanel>
                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0">
                            <TextBox x:Name="SecurityOutput" IsReadOnly="True" AcceptsReturn="True"
                                     Background="#071522" Foreground="{StaticResource GhostIce}" BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas" Padding="14"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>

                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Margin="24"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="920">
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <WrapPanel>
                                    <StackPanel Width="440" Margin="0,0,14,8">
                                        <TextBlock Text="Monitoring" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Choose how often Dashboard auto-refresh polls the selected server."
                                                   Foreground="{StaticResource GhostMuted}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Width="200" Margin="0,0,0,8">
                                        <Label Content="Refresh interval"/>
                                        <ComboBox x:Name="RefreshIntervalBox" Style="{StaticResource GhostComboBox}" SelectedIndex="1">
                                            <ComboBoxItem Content="15 seconds" Tag="15"/>
                                            <ComboBoxItem Content="30 seconds" Tag="30"/>
                                            <ComboBoxItem Content="60 seconds" Tag="60"/>
                                            <ComboBoxItem Content="120 seconds" Tag="120"/>
                                        </ComboBox>
                                    </StackPanel>
                                </WrapPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Backup location" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Optional default folder for downloaded configuration snapshots."
                                               Foreground="{StaticResource GhostMuted}" Margin="0,5,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="DefaultBackupFolderBox" Style="{StaticResource GhostTextBox}" IsReadOnly="True"
                                                 AutomationProperties.Name="Default backup folder"/>
                                        <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                                    Click="BrowseBackupFolder_Click">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Choose folder" Margin="7,0,0,0"/></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}"
                                                    Click="ClearBackupFolder_Click"
                                                    AutomationProperties.Name="Clear default backup folder">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE894;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Clear" Margin="7,0,0,0"/></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <WrapPanel>
                                    <StackPanel Width="440" Margin="0,0,14,8">
                                        <TextBlock Text="Window layout" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Remember the last comfortable normal-window size. Fit window is never stored as a startup full-screen state."
                                                   Foreground="{StaticResource GhostMuted}" Margin="0,5,0,10" TextWrapping="Wrap"/>
                                        <CheckBox x:Name="RememberWindowSizeToggle"
                                                  Content="Remember normal window size"
                                                  AutomationProperties.Name="Remember normal window size"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GhostButton}" VerticalAlignment="Center" Margin="0,0,0,8"
                                            Click="ResetWindowLayout_Click"
                                            AutomationProperties.Name="Reset window size">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" Style="{StaticResource FluentIcon}"/>
                                            <TextBlock Text="Reset window size" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Server profiles" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Export or import connection profiles. Passwords and private-key passphrases are never included because Ghost Server never stores them."
                                               Foreground="{StaticResource GhostMuted}" TextWrapping="Wrap" Margin="0,5,0,12"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource GhostButton}" Click="ExportProfiles_Click" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Export profiles" Margin="7,0,0,0"/></StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource GhostButton}" Click="ImportProfiles_Click" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE898;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Import profiles" Margin="7,0,0,0"/></StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Application data" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AppDataPathText" Foreground="{StaticResource GhostMuted}"
                                                   Margin="0,5,16,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                                            Click="OpenAppData_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Open folder" Margin="7,0,0,0"/></StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="About Ghost Server" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AboutVersionText" Foreground="{StaticResource GhostMuted}" Margin="0,6,0,0"/>
                                        <TextBlock Text=".NET 10 • WPF • SSH.NET • Windows 10/11"
                                                   Foreground="{StaticResource GhostMuted}" Margin="0,3,0,0"/>
                                        <TextBlock Text="SSH host-key pinning, session-only secrets and verified SFTP are enforced across remote operations."
                                                   Foreground="{StaticResource GhostMuted}" TextWrapping="Wrap" Margin="0,8,20,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource AccentButton}" VerticalAlignment="Center"
                                            Click="SaveSettings_Click">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/><TextBlock Text="Save settings" Margin="7,0,0,0" Foreground="#06121E"/></StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="SettingsStatusText" Foreground="{StaticResource GhostMuted}" Margin="2,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#08182B" BorderBrush="{StaticResource GhostBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource GhostMuted}"
                           VerticalAlignment="Center" FontSize="11" Margin="0,0,12,0"
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.Name="Application status"
                           AutomationProperties.LiveSetting="Polite"/>
                <TextBlock x:Name="StatusShortcutText" Text="Ctrl+N Add  •  Ctrl+L Lock  •  F5 Refresh" Foreground="{StaticResource GhostMuted}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11"/>
            </Grid>
        </Border>

        <Grid x:Name="AddServerOverlay" Grid.RowSpan="3" Background="#D9071322" Visibility="Collapsed">
            <Border x:Name="AddServerCard" Width="560" MaxWidth="560" MaxHeight="710" Style="{StaticResource CardBorder}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24" Margin="20"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <TextBlock x:Name="AddServerTitle" Text="Add server" FontSize="22" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                    Click="CloseAddServer_Click" ToolTip="Close"
                                     AutomationProperties.Name="Close server editor">
                                <TextBlock Text="&#xE8BB;" Style="{StaticResource FluentIcon}"/>
                            </Button>
                        </Grid>

                        <Label Content="Display name" Target="{Binding ElementName=AddName}"/>
                        <TextBox x:Name="AddName" Style="{StaticResource GhostTextBox}" Margin="0,0,0,12"/>

                        <Label Content="Host or IP" Target="{Binding ElementName=AddHost}"/>
                        <TextBox x:Name="AddHost" Style="{StaticResource GhostTextBox}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <Label Content="Username" Target="{Binding ElementName=AddUsername}"/>
                                <TextBox x:Name="AddUsername" Style="{StaticResource GhostTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label Content="Port" Target="{Binding ElementName=AddPort}"/>
                                <TextBox x:Name="AddPort" Style="{StaticResource GhostTextBox}" Text="22"/>
                            </StackPanel>
                        </Grid>

                        <Label Content="Authentication" Target="{Binding ElementName=AddAuthentication}"/>
                        <ComboBox x:Name="AddAuthentication" Style="{StaticResource GhostComboBox}" SelectedIndex="0"
                                  SelectionChanged="AddAuthentication_SelectionChanged" Margin="0,0,0,12">
                            <ComboBoxItem Content="Password" Tag="Password"/>
                            <ComboBoxItem Content="Private key" Tag="PrivateKey"/>
                        </ComboBox>

                        <StackPanel x:Name="PrivateKeyPanel" Visibility="Collapsed" Margin="0,0,0,12">
                            <Label Content="Private key path" Target="{Binding ElementName=AddPrivateKeyPath}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AddPrivateKeyPath" Style="{StaticResource GhostTextBox}"/>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                        Click="BrowsePrivateKey_Click" ToolTip="Browse for private key">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Browse" Margin="7,0,0,0"/></StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="Passwords and private-key passphrases are never stored in the profile. Enter the session secret after selecting the server."
                                   Foreground="{StaticResource GhostMuted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,14"/>

                        <TextBlock x:Name="AddError" Foreground="{StaticResource GhostDanger}" TextWrapping="Wrap"
                                   Visibility="Collapsed" Margin="0,0,0,10"
                                   AutomationProperties.Name="Server editor validation error"
                                   AutomationProperties.LiveSetting="Assertive"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    Click="CloseAddServer_Click" IsCancel="True"/>
                            <Button x:Name="SaveServerButton" Content="Save server" Style="{StaticResource AccentButton}"
                                    Click="SaveServer_Click" IsDefault="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="ConfirmOverlay" Grid.RowSpan="3" Background="#D9071322" Visibility="Collapsed">
            <Border x:Name="ConfirmCard" Width="470" MaxWidth="470" Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24" Margin="20" BorderBrush="{StaticResource GhostDanger}"
                    FocusManager.IsFocusScope="True"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource GhostDangerSurface}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource GhostDanger}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="Delete server?" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="This removes the local profile only. Nothing is deleted from the remote server."
                                       Foreground="{StaticResource GhostMuted}" TextWrapping="Wrap" Margin="0,5,0,0" MaxWidth="350"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="ConfirmMessage" Margin="0,18,0,18" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="ConfirmCancelButton" Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                Click="CancelDelete_Click" IsCancel="True"/>
                        <Button Content="Delete profile" Style="{StaticResource DangerButton}" Click="ConfirmDelete_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
