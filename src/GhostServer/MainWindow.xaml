                            <WrapPanel>
                                <StackPanel Width="170" Margin="0,0,8,8">
                                    <Label Content="Task name"/>
                                    <TextBox x:Name="TaskNameBox" Style="{StaticResource GhostTextBox}" ToolTip="lowercase letters, numbers and hyphens"/>
                                </StackPanel>

                                <StackPanel Width="145" Margin="0,0,8,8">
                                    <Label Content="Schedule"/>
                                    <ComboBox x:Name="TaskScheduleBox" Style="{StaticResource GhostComboBox}" SelectedIndex="1">
                                        <ComboBoxItem Content="Hourly" Tag="Hourly"/>
                                        <ComboBoxItem Content="Daily" Tag="Daily"/>
                                        <ComboBoxItem Content="Weekly" Tag="Weekly"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Width="320" Margin="0,0,8,8">
                                    <Label Content="Command"/>
                                    <TextBox x:Name="TaskCommandBox" Style="{StaticResource GhostTextBox}" FontFamily="Cascadia Code, Consolas"
                                             ToolTip="Command runs as root through a dedicated Ghost Server oneshot service"/>
                                </StackPanel>

                                <Button Style="{StaticResource AccentButton}" VerticalAlignment="Bottom"
                                        Click="CreateTask_Click" Margin="0,20,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/>
                                        <TextBlock Text="Create task" Margin="7,0,0,0" Foreground="#06121E"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

