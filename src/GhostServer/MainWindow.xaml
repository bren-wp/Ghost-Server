                                <StackPanel><TextBlock Text="ACTIVE" Foreground="{StaticResource GhostMuted}" FontSize="10"/><TextBlock x:Name="AlertsActiveValue" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="ACKNOWLEDGED" Foreground="{StaticResource GhostMuted}" FontSize="10"/><TextBlock x:Name="AlertsAcknowledgedValue" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="ATTENTION" Foreground="{StaticResource GhostMuted}" FontSize="10"/><TextBlock x:Name="AlertsAttentionValue" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel><TextBlock Text="FAILURES" Foreground="{StaticResource GhostMuted}" FontSize="10"/><TextBlock x:Name="AlertsFailuresValue" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="8">
                            <ListView x:Name="AlertsList" Background="Transparent" BorderThickness="0"
                                      Foreground="{StaticResource GhostIce}">
