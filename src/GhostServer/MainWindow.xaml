                                <StackPanel><TextBlock Text="SERVERS" Foreground="{StaticResource GhostMuted}" FontSize="10"/><TextBlock x:Name="TrendsServersValue" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Text="LATEST RISKS" Foreground="{StaticResource GhostMuted}" FontSize="10"/><TextBlock x:Name="TrendsRisksValue" Text="0" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                            </Border>
