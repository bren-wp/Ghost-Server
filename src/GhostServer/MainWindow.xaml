                                        <GridViewColumn Header="CPU" DisplayMemberBinding="{Binding Cpu}" Width="70"/>
                                        <GridViewColumn Header="RAM" DisplayMemberBinding="{Binding Memory}" Width="100"/>
                                        <GridViewColumn Header="Load" DisplayMemberBinding="{Binding Load}" Width="90"/>
