                                <StackPanel><TextBlock Text="HIGHEST AVG DISK" Foreground="{StaticResource GhostMuted}" FontSize="10"/><TextBlock x:Name="TrendsDiskValue" Text="—" FontSize="24" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
