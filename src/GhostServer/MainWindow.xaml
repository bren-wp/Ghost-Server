                            <Button Style="{StaticResource AccentButton}" Margin="0,0,8,8"
                                    Click="AcknowledgeAlert_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource FluentIcon}" Foreground="#06121E"/>
                                    <TextBlock Text="Acknowledge selected" Margin="7,0,0,0" Foreground="#06121E"/>
                                </StackPanel>
