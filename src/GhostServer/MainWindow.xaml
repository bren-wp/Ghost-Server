                            <Button Content="Stop" Style="{StaticResource GhostButton}" Click="StopService_Click" Margin="0,0,8,8"/>
                            <Button Content="Restart" Style="{StaticResource GhostButton}" Click="RestartService_Click" Margin="0,0,8,8"/>
                            <Button Style="{StaticResource GhostButton}" Click="ServiceLogs_Click" Margin="0,0,0,8" ToolTip="Open recent logs for the selected service">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF000;" Style="{StaticResource FluentIcon}"/><TextBlock Text="View logs" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Grid.Row="1" x:Name="SelectedServiceText" Text="Select a service."
