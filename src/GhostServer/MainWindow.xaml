                                            <GridViewColumn Header="Recorded" DisplayMemberBinding="{Binding RecordedLocal}" Width="145"/>
                                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="110"/>
                                            <GridViewColumn Header="CPU" DisplayMemberBinding="{Binding CpuLabel}" Width="70"/>
                                            <GridViewColumn Header="RAM" DisplayMemberBinding="{Binding MemoryLabel}" Width="70"/>
                                            <GridViewColumn Header="Disk" DisplayMemberBinding="{Binding DiskLabel}" Width="70"/>
                                            <GridViewColumn Header="Load" DisplayMemberBinding="{Binding Load}" Width="90"/>
                                            <GridViewColumn Header="Details" DisplayMemberBinding="{Binding Message}" Width="290"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="AlertsPage" Visibility="Collapsed" Margin="24">
