                                    <GridView>
                                        <GridViewColumn Header="Recorded" DisplayMemberBinding="{Binding RecordedLocal}" Width="145"/>
                                        <GridViewColumn Header="Server" DisplayMemberBinding="{Binding ServerName}" Width="150"/>
                                        <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="115"/>
                                        <GridViewColumn Header="Acknowledgement" DisplayMemberBinding="{Binding Acknowledgement}" Width="175"/>
                                        <GridViewColumn Header="CPU" DisplayMemberBinding="{Binding Cpu}" Width="70"/>
                                        <GridViewColumn Header="RAM" DisplayMemberBinding="{Binding Memory}" Width="70"/>
                                        <GridViewColumn Header="Disk" DisplayMemberBinding="{Binding Disk}" Width="70"/>
                                        <GridViewColumn Header="Load" DisplayMemberBinding="{Binding Load}" Width="85"/>
                                        <GridViewColumn Header="Details" DisplayMemberBinding="{Binding Details}" Width="270"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>
                    </Grid>

                    <Grid x:Name="TrendsPage" Visibility="Collapsed" Margin="24">
