                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="FleetHistoryTitle" Text="Health history" FontWeight="SemiBold"/>
                                        <TextBlock Text="Local-only probe history. CPU, RAM or disk at 90%+ is marked Attention."
