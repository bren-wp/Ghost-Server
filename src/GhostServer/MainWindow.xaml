                            <Button Style="{StaticResource GhostButton}" Click="RefreshTasks_Click" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource FluentIcon}"/><TextBlock Text="Refresh" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Click="DeleteTask_Click" Margin="0,0,12,8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource FluentIcon}" Foreground="{StaticResource GhostDanger}"/><TextBlock Text="Delete selected" Margin="7,0,0,0"/></StackPanel>
                            </Button>
                            <TextBlock x:Name="TasksStatusText" Foreground="{StaticResource GhostMuted}" VerticalAlignment="Center" Margin="0,0,0,8"
                                       Text="Only Ghost Server timers named ghost-server-* are managed here."/>
                        </WrapPanel>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource CardBorder}" Padding="8">
                                <ListView x:Name="TasksList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource GhostIce}">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="180"/>
                                            <GridViewColumn Header="Schedule" DisplayMemberBinding="{Binding Schedule}" Width="130"/>
                                            <GridViewColumn Header="Next run" DisplayMemberBinding="{Binding NextRun}" Width="250"/>
                                            <GridViewColumn Header="State" DisplayMemberBinding="{Binding State}" Width="110"/>
                                            <GridViewColumn Header="Enabled" DisplayMemberBinding="{Binding EnabledLabel}" Width="110"/>
