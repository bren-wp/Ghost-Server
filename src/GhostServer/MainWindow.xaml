                                        <GridViewColumn Header="Avg RAM" DisplayMemberBinding="{Binding AverageMemoryLabel}" Width="80"/>
                                        <GridViewColumn Header="Max RAM" DisplayMemberBinding="{Binding MaxMemoryLabel}" Width="80"/>
                                        <GridViewColumn Header="Avg Disk" DisplayMemberBinding="{Binding AverageDiskLabel}" Width="80"/>
                                        <GridViewColumn Header="Max Disk" DisplayMemberBinding="{Binding MaxDiskLabel}" Width="80"/>
                                        <GridViewColumn Header="Latest" DisplayMemberBinding="{Binding LatestStatus}" Width="120"/>
                                    </GridView>
