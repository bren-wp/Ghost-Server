<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GhostServer</AssemblyName>
    <RootNamespace>GhostServer</RootNamespace>
    <Version>0.2.0</Version>
    <Authors>Brendigo</Authors>
    <Product>Ghost Server</Product>
    <Description>Secure Windows server management for SSH-connected Linux servers.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>
</Project>
